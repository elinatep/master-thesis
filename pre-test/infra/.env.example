# Copy this file to infra/.env and fill it in. infra/.env is gitignored - it holds secrets.
#
#   macOS / Linux:       cp infra/.env.example infra/.env
#   Windows PowerShell:  Copy-Item infra\.env.example infra\.env

# --- Resource group (required) ---
# The group you created in the Azure portal. It must already exist; the deploy does not create it.
RESOURCE_GROUP=rg-e2-feeling-heard

# --- Database password (required) ---
# YOU CHOOSE THIS. It is not looked up anywhere: this deployment creates its own Postgres server,
# and this is the admin password it is created with. On the first deploy it is set; after that the
# server keeps it, so save it somewhere you will still have it in December.
#
# Rules: 8-128 characters, at least three of upper case, lower case, digit, special character.
# Must not contain the admin username. Avoid $ ` " and \ - PowerShell and bash both mangle them.
DB_ADMIN_PASSWORD=

# Optional - defaults to 'portaladmin'.
#DB_ADMIN_USER=

# --- Qualtrics handover secret (set this before a real run) ---
# A random string you invent. Qualtrics sends it as the X-Handover-Secret header when it registers
# a participant's arm. Without it, anyone who finds the study URL can mint a token and enter in
# whichever arm they like, and those responses are indistinguishable from real ones in the data.
#
# Generate one:  macOS / Linux  ->  uuidgen
#                PowerShell     ->  [guid]::NewGuid().ToString()
HANDOVER_SECRET=

# --- Easy Auth (leave BOTH empty for the real study run) ---
# Setting both puts an Entra login wall in front of the whole app. That blocks anonymous Prolific
# participants and breaks the Qualtrics iframe. Only useful while building, to keep the half-built
# study off the open internet.
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
