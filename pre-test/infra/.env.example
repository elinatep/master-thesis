# Copy this file to infra/.env (which is gitignored) and fill in real values.
# Consumed by scripts/deploy.ps1 and passed as Bicep parameters.

# --- Database (required) ---
# The password the SHARED Postgres server was created with (see levels-of-ai-help/infra/.env).
# The pre-test does not create the server; it creates its own database on it.
DB_ADMIN_PASSWORD=
# Optional - defaults to 'portaladmin' if omitted.
#DB_ADMIN_USER=

# --- Qualtrics handover (set this for a real run) ---
# Shared secret Qualtrics must send as the X-Handover-Secret header when POSTing /api/handover.
# Empty = no check, which is fine locally and NOT fine in production: without it, anyone who finds
# the URL can mint a token and enter the study in whichever arm they like, and those responses look
# exactly like real ones in the data.
HANDOVER_SECRET=

# --- Easy Auth (leave BOTH empty for the real study run) ---
# Setting both puts an Entra login wall in front of the whole app, which blocks anonymous Prolific
# participants. Useful only while building.
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# --- Resource group ---
# The group the shared platform lives in. Defaults to rg-insurance-portal.
#RESOURCE_GROUP=rg-insurance-portal
